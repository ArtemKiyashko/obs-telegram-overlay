<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ObsTelegramOverlay.Application\ObsTelegramOverlay.Application.csproj" />
    <ProjectReference Include="..\ObsTelegramOverlay.Infrastructure\ObsTelegramOverlay.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.56.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <AssemblyName>obstelegramoverlay_bot</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <None Remove="appsettings.Development.json" />
    <EmbeddedResource Include="Templates/default-overlay-template.html" />
  </ItemGroup>

</Project>
